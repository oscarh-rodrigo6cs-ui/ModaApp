            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CatalogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DatosPedidoActivity"
            android:exported="false"
